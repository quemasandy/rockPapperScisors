  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node": "^26.0.0",
    "dependency-cruiser": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
